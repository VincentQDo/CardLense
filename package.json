{
  "name": "cardlense",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "host": "vite dev --host 0.0.0.0 --port 3000",
    "format": "prettier --write .",
    "lint": "eslint .",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@eslint/css": "1.1.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@eslint/markdown": "8.0.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.57.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
    "svelte": "5.55.2",
    "svelte-check": "4.4.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.7"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.2",
    "daisyui": "5.5.19",
    "tailwindcss": "4.2.2"
  }
}
